# forum-cloud 本地环境变量示例
# 不要提交真实值；空值也会覆盖 application.yml 的默认值，只设置需要覆盖的项。

FORUM_ENV=dev
# 端口使用各服务默认值：gateway 4433/9080；user 8082/9082；content 8083/9083；
# notification 8084/9084；media 8085/9085；weather 8086/9086。
NACOS_ENABLED=false
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
FORUM_USER_URI=http://localhost:8082
FORUM_CONTENT_URI=http://localhost:8083
FORUM_NOTIFICATION_URI=http://localhost:8084
FORUM_MEDIA_URI=http://localhost:8085
FORUM_WEATHER_URI=http://localhost:8086
FORUM_USER_SERVICE_URL=http://localhost:8082
FORUM_INTERNAL_TOKEN=dev-internal-token
GATEWAY_JWT_ENABLED=true

FORUM_JWT_SECRET=
FORUM_JWT_EXPIRE_DAYS=7

FORUM_MAIL_HOST=smtp.163.com
FORUM_MAIL_PORT=465
FORUM_MAIL_USERNAME=
FORUM_MAIL_PASSWORD=
FORUM_MAIL_SSL_TRUST=smtp.163.com

FORUM_RABBIT_ADDR=localhost
# 当前本地测试容器使用 guest/guest；正式环境请替换。
FORUM_RABBIT_USERNAME=guest
FORUM_RABBIT_PASSWORD=guest

FORUM_REDIS_HOST=localhost
FORUM_REDIS_PORT=6379
FORUM_REDIS_PASSWORD=
FORUM_REDIS_DB=0

# PostgreSQL / AWS RDS：
# 四个服务共用 postgres 数据库，通过 currentSchema 隔离。
# 本地无 SSL 时用 sslmode=prefer；AWS RDS 改为 sslmode=require。
FORUM_USER_DB_USERNAME=postgres
FORUM_USER_DB_PASSWORD=
FORUM_USER_DB_URL="jdbc:postgresql://localhost:5432/postgres?currentSchema=forum_user&sslmode=prefer"

FORUM_CONTENT_DB_USERNAME=postgres
FORUM_CONTENT_DB_PASSWORD=
FORUM_CONTENT_DB_URL="jdbc:postgresql://localhost:5432/postgres?currentSchema=forum_content&sslmode=prefer"

FORUM_NOTIFICATION_DB_USERNAME=postgres
FORUM_NOTIFICATION_DB_PASSWORD=
FORUM_NOTIFICATION_DB_URL="jdbc:postgresql://localhost:5432/postgres?currentSchema=forum_notification&sslmode=prefer"

FORUM_MEDIA_DB_USERNAME=postgres
FORUM_MEDIA_DB_PASSWORD=
FORUM_MEDIA_DB_URL="jdbc:postgresql://localhost:5432/postgres?currentSchema=forum_media&sslmode=prefer"

FORUM_MINIO_ENDPOINT=http://localhost:9000
FORUM_MINIO_USERNAME=minio
FORUM_MINIO_PASSWORD=

FORUM_WEATHER_KEY=
