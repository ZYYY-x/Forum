# 复制到 IDE/终端环境变量中使用；不要提交真实值。
# 注意：空值也会覆盖 application.yml 的默认值，只设置需要覆盖的项。
# PowerShell 示例：
#   $env:FORUM_JWT_SECRET = "..."
#   $env:FORUM_MAIL_USERNAME = "..."
#   $env:FORUM_MAIL_PASSWORD = "..."
#   $env:FORUM_WEATHER_KEY = "..."

FORUM_JWT_SECRET=
FORUM_JWT_EXPIRE_DAYS=7

FORUM_MAIL_HOST=smtp.163.com
FORUM_MAIL_PORT=465
FORUM_MAIL_USERNAME=
FORUM_MAIL_PASSWORD=
FORUM_MAIL_SSL_TRUST=smtp.163.com

FORUM_RABBIT_ADDR=localhost
FORUM_RABBIT_USERNAME=admin
FORUM_RABBIT_PASSWORD=

FORUM_REDIS_HOST=localhost
FORUM_REDIS_PORT=6379
FORUM_REDIS_PASSWORD=
FORUM_REDIS_DB=0

FORUM_DB_USERNAME=root
FORUM_DB_PASSWORD=
FORUM_DB_URL=jdbc:mysql://localhost:3306/study

FORUM_MINIO_ENDPOINT=http://localhost:9000
FORUM_MINIO_USERNAME=minio
FORUM_MINIO_PASSWORD=

FORUM_WEATHER_KEY=
