      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(forum_topic_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(forum_topic_cache_total[5m])), 0.001)", "legendFormat": "topic list cache hit", "refId": "A"}],
      "title": "Topic List Cache Hit Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(forum_interaction_total[5m])) by (type)", "legendFormat": "{{type}}", "refId": "A"}],
      "title": "Interactions by Type",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
